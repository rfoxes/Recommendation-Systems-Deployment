# Copy to .env for local development. Never commit .env.
MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DB=simula
REDIS_URL=redis://localhost:6379/0

# Ad serving: public base URL embedded in ads, and the click-only key that ships inside ad HTML
API_URL=http://localhost:8000
CLICK_API_KEY=dev-click-key

# Temporal: defaults target the local dev server. For Temporal Cloud set all three.
# TEMPORAL_ADDRESS=us-central1.gcp.api.temporal.io:7233
# TEMPORAL_NAMESPACE=<namespace>.<account>
# TEMPORAL_API_KEY=<api key>

# LLM for ad copy: gemini | anthropic | openai. Only the chosen provider's key is needed;
# with no key, ads fall back to the ad set's fallback_copy.
LLM_PROVIDER=gemini
# LLM_MODEL=            # optional; defaults to the provider's recommended model
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
