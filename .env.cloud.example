# Copy to .env.cloud (gitignored) and fill in; scripts/deploy.sh reads it. Secrets go to Secret Manager.
GCP_PROJECT=simula-take-home-xxxx
REGION=us-central1

# MongoDB Atlas free cluster (GCP us-central1). Database user + password are inside the URI.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=simula

# Upstash Redis (free, GCP us-central1); note rediss:// (TLS)
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# Temporal Cloud: namespace page -> "gRPC endpoint" and "Namespace ID"; API key from Settings -> API keys
TEMPORAL_ADDRESS=us-central1.gcp.api.temporal.io:7233
TEMPORAL_NAMESPACE=<namespace>.<account>
TEMPORAL_API_KEY=

# LLM for ad copy (gemini | anthropic | openai); only the chosen provider's key is needed
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Click-only key embedded in ad HTML. Generate one: openssl rand -hex 16
CLICK_API_KEY=
